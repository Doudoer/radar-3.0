# ==============================================================================
# RADAR 3.0 - Configuración de Variables de Entorno de Ejemplo
# ==============================================================================
# IMPORTANTE: Copie este archivo como .env en su servidor y reemplace los valores.
# NUNCA suba el archivo .env a repositorios públicos o compartidos.

# ------------------------------------------------------------------------------
# 1. ENTORNO Y SERVIDOR
# ------------------------------------------------------------------------------
NODE_ENV=production
PORT=3000
APP_URL=https://radar-rsy.site
CORS_ORIGIN=https://radar-rsy.site

# ------------------------------------------------------------------------------
# 2. AUTENTICACIÓN Y SEGURIDAD (JWT)
# ------------------------------------------------------------------------------
# Generar una clave secreta segura de 64 caracteres con:
# node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=reemplazar_con_clave_criptografica_segura_de_64_caracteres_o_mas

# ------------------------------------------------------------------------------
# 3. BASE DE DATOS MYSQL (Principio de Menor Privilegio)
# ------------------------------------------------------------------------------
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=radar_v3
DB_USER=radar_app
DB_PASSWORD=ContrasenaFuerteApp123!

# ------------------------------------------------------------------------------
# 4. INTEGRACIÓN WASENDER (WhatsApp Notifications & 2FA)
# ------------------------------------------------------------------------------
WASENDER_API_KEY=tu_api_key_de_wasender
WASENDER_SESSION=Douglas_Movistar
SUPER_ADMIN_PHONE=584145380654
NOTIFICATION_TEST_MODE=false
