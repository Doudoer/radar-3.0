# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

PORT="3000"
API_PORT="3000"
JWT_SECRET="GENERATE_A_LONG_RANDOM_SECRET"
DB_HOST="127.0.0.1"
DB_PORT="3306"
DB_NAME="radar_v3"
DB_USER="radar_app"
DB_PASSWORD="CHANGE_ME"
CORS_ORIGIN="https://radar-rsy.store"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Future file/image uploads
UPLOAD_DIR="/app/storage/uploads"
MAX_UPLOAD_BYTES="10485760"

# Future Wasender integration. Keep credentials only in Dokploy secrets.
WASENDER_BASE_URL=""
WASENDER_API_KEY=""
WASENDER_DEVICE_ID=""
WASENDER_SEND_TEXT_PATH="/api/send-message"
WASENDER_SEND_IMAGE_PATH="/api/send-image"
WASENDER_SEND_FILE_PATH="/api/send-file"

# Future notifications. Wasender remains disabled until explicitly enabled.
NOTIFICATIONS_ENABLED="true"
NOTIFICATIONS_WASENDER_ENABLED="false"
NOTIFICATIONS_DEFAULT_RECIPIENTS=""
NOTIFICATIONS_EVENT_CONFIG=""
# Optional per-event overrides: NOTIFICATIONS_ORDER_ENABLED, NOTIFICATIONS_CLAIM_RECIPIENTS, etc.
