NODE_ENV=production
PORT=3000
APP_URL=https://radar.example.com
CORS_ORIGIN=https://radar.example.com
# Enable only behind a trusted proxy that overwrites X-Real-IP and X-Forwarded-Proto.
TRUST_PROXY=1
DB_HOST=db
DB_PORT=3306
DB_NAME=radar_v3
DB_USER=radar_app
DB_PASSWORD=
# Generate privately with: openssl rand -hex 32
JWT_SECRET=
WASENDER_ENABLED=false
WASENDER_BASE_URL=https://wasenderapi.com
WASENDER_API_KEY=
WASENDER_FORCE_TEST_RECIPIENT=false
