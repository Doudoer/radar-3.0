{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "api": "tsx --env-file=.env server.ts",
    "db:up": "docker compose -f compose.local.yml up -d --wait",
    "db:down": "docker compose -f compose.local.yml down",
    "local:wasender": "docker compose --env-file .env.wasender.local -f compose.desktop.yml -f compose.wasender.local.yml up -d app",
    "local:wasender:off": "docker compose -f compose.desktop.yml up -d app",
    "db:migrate": "tsx --env-file=.env scripts/migrate.ts",
    "db:seed": "tsx --env-file=.env scripts/seed.ts",
    "db:setup": "npm run db:migrate && npm run db:seed",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "vitest run --config vitest.e2e.config.mjs",
    "test:watch": "vitest",
    "test:ui:horizon": "tsx scripts/test-horizon-ui.ts",
    "build:api": "esbuild server.ts --bundle --platform=node --format=esm --outfile=dist/server.js --packages=external && esbuild scripts/migrate.ts --bundle --platform=node --format=esm --outfile=dist/migrate.js --packages=external",
    "build": "vite build && npm run build:api",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit",
    "ci": "npm run lint && npm run test:coverage && npm run build",
    "security:check": "tsx scripts/security-check.ts",
    "backup:now": "tsx --env-file=.env scripts/run-backup.ts manual",
    "backup:verify": "tsx --env-file=.env scripts/verify-backup-integrity.ts"
  },
  "engines": {
    "node": ">=22 <23"
  },
  "dependencies": {
    "@fontsource-variable/dm-sans": "^5.3.0",
    "@fontsource-variable/material-symbols-outlined": "^5.3.9",
    "bcryptjs": "^3.0.3",
    "jsonwebtoken": "^9.0.3",
    "mysql2": "^3.14.4",
    "pdf-lib": "^1.17.1",
    "qrcode": "^1.5.4",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.20.3",
    "@types/qrcode": "^1.5.6",
    "@vitejs/plugin-react": "^5.0.4",
    "@vitest/coverage-v8": "^5.1.0",
    "autoprefixer": "^10.6.1",
    "esbuild": "^0.25.0",
    "postcss": "^8.5.29",
    "puppeteer-core": "^25.14.0",
    "tailwindcss": "^3.4.19",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3",
    "vitest": "^5.0.1"
  }
}
